# Copy to .env and fill in. NEVER commit .env.

# ---- always needed ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
EXERCISE_IMAGE_BASE_URL=https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/

# ---- laptop use: nothing else needed (one local user, SQLite file in this folder) ----
# DATABASE_URL=sqlite:///./fitchat.db

# ---- hosted (Vercel + Supabase): set these in Vercel's Environment Variables ----
# AUTH_MODE=supabase
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_ANON_KEY=
# ADMIN_EMAILS=you@example.com            # who sees the on/off switch (must be a confirmed address)
# APP_SECRET=                              # long random text; encrypts users' own Gemini keys
# AUTO_MIGRATE=false                       # tables are created once with: python -m app.initdb
# APP_TZ=Asia/Kolkata                      # fallback time zone; each browser sends its own
# DAILY_CHAT_LIMIT=40                      # coach messages per person per day on your Gemini key
