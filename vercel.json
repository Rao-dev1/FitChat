{
  "functions": {
    "api/index.py": {
      "includeFiles": "{app,data}/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__p=/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/api/index?__p=/:path*"
    }
  ]
}
